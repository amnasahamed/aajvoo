{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vow-and-verse",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "auto-trailing-slash"},
  "vars": {
    "WEDDING_DOMAIN": "weddings.example",
    "GALLERY_HOST": "weddings.example",
    "ADMIN_HOST": "admin.weddings.example",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  },
  "d1_databases": [{"binding": "DB", "database_name": "REPLACE_AFTER_APPROVAL", "database_id": "REPLACE_AFTER_APPROVAL", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "REPLACE_AFTER_APPROVAL"}],
  "routes": [
    {"pattern": "weddings.example/*", "zone_name": "REPLACE_AFTER_APPROVAL"},
    {"pattern": "*.weddings.example/*", "zone_name": "REPLACE_AFTER_APPROVAL"}
  ],
  "observability": {"enabled": false}
}
